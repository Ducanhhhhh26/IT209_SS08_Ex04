<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      Model Context Protocol (MCP) Stdio Transport Protection:
      Directing all console log outputs to System.err to prevent Stdio Pollution on System.out (preserving JSON-RPC packets).
    -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR" />
    </root>
</configuration>
